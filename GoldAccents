  const hi = text => {
    if(!q) return <span>{text}</span>;
    const re = new RegExp(`(${q})`, "gi");
    return text.split(re).map((p,i)=>re.test(p)?<mark key={i} style={{background:"var(--gold-soft)",color:"var(--gold-bright)",padding:"0 2px",borderRadius:3}}>{p}</mark>:<span key={i}>{p}</span>);
  };
  return (
    <div style={{padding:32,maxWidth:760,margin:"0 auto"}} className="fade-in">
      <button onClick={onBack} style={{display:"flex",alignItems:"center",gap:8,background:"none",border:"none",color:"var(--cream-60)",fontWeight:600,fontSize:13,cursor:"pointer",marginBottom:22,padding:0,fontFamily:"inherit"}} onMouseOver={e=>e.currentTarget.style.color="var(--gold)"} onMouseOut={e=>e.currentTarget.style.color="var(--cream-60)"}>
        <ArrowLeft size={15}/>Back to Library
