      <div className="glass-strong fade-in-up" style={{padding:36,marginBottom:18,borderRadius:24}}>
        <div style={{display:"flex",justifyContent:"space-between",alignItems:"flex-start",marginBottom:22,gap:16,flexWrap:"wrap"}}>
          <div>
            <p className="caps" style={{color:"var(--gold)",margin:"0 0 8px"}}>{sermon.series}</p>
            <h1 className="serif-bold" style={{fontSize:34,color:"var(--cream)",margin:"0 0 8px",lineHeight:1.15}}>{sermon.title}</h1>
            <p style={{color:"var(--cream-60)",fontSize:14,margin:0}}>{sermon.speaker} · {sermon.date}</p>
